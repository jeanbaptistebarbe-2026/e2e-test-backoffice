{
  "name": "e2e-backoffice",
  "version": "1.0.0",
  "description": "Tests E2E Playwright pour le backoffice Swapn (qg.swapn.tech)",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:readonly": "playwright test --grep-invert \"@ecriture\"",
    "test:write": "playwright test --grep \"@ecriture\"",
    "test:auth": "playwright test --grep \"@auth\"",
    "test:admin": "playwright test --grep \"@role-admin\"",
    "test:bpo": "playwright test --grep \"@role-bpo\"",
    "test:grep": "playwright test --grep",
    "test:key": "node scripts/run-e2e.mjs",
    "secrets:encrypt": "node scripts/secrets-encrypt.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@slack/web-api": "^7.18.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.5.0",
    "dotenv": "^17.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "imapflow": "^1.3.1",
    "mailparser": "^3.9.9"
  }
}
